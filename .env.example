# =============================================================================
# SECRETS ONLY.
# Everything else (models, routing, timings, permission tiers) lives in
# config.json — edit that instead of adding knobs here.
# =============================================================================

# Required — Discord application bot token
DISCORD_BOT_TOKEN=

# Required — InferencePort API key (every AI feature: replies, automod, memory)
INFERENCEPORT_API_KEY=

# Optional — tonearm music server
TONEARM_URL=
TONEARM_API_KEY=

# Optional — second chat provider (gateway). Base URL and model are configured
# in config.json under ai.gateway; only the key belongs here.
AI_GATEWAY_KEY=

# Optional — web search tool
TINYFISH_API_KEY=

# Optional — nightly backup to S3 (memory cortex + config)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Optional — E2B sandbox control (shepherd, launcher)
E2B_API_KEY=
