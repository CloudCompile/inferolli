{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "inferenceport": {
      "name": "InferencePort",
      "env": ["INFERENCEPORT_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.inferenceport.ai/v1"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "limit": {"context": 1050000, "output": 32000},
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]}
        },
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": {"context": 1048576, "output": 32000},
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]}
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {"context": 1050000, "output": 32000},
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]}
        },
        "gemini-4-hydrogen": {
          "name": "Gemini 4 Hydrogen",
          "limit": {"context": 1048576, "output": 32000},
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]}
        }
      }
    }
  },
  "model": "inferenceport/deepseek-v4.1-flash-1017",
  "share": "disabled"
}
